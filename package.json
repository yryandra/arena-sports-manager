{
  "name": "sports-manager",
  "version": "1.0.0",
  "description": "ARENA — a full-stack sports operations platform built with Vue, TypeScript, Express and MongoDB.",
  "private": true,
  "main": "server.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server.js",
    "dev:client": "npm --prefix client run dev",
    "setup": "npm ci && npm --prefix client ci",
    "build": "npm --prefix client run build",
    "check": "npm test && npm run build",
    "seed": "node scripts/seed.js",
    "admin:setup": "node scripts/admin-setup.js",
    "test:mongodb": "node scripts/verify-mongodb.js",
    "start": "node server.js"
  },
  "keywords": [
    "sports",
    "vue",
    "typescript",
    "express",
    "mongodb",
    "portfolio"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.12.2",
    "pug": "^3.0.4"
  }
}
